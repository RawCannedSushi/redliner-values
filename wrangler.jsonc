{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archives-redliner-values",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "secrets": {
    "required": ["SHEET_ID", "GOOGLE_SERVICE_ACCOUNT_JSON"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archives-redliner-history",
      "database_id": "aed6219e-5c30-4a58-a2c3-8e7aa47910c4",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
